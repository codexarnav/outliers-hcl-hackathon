# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Operational Mode
# Set MOCK_LLM=true for offline deterministic testing and sub-10ms latency evaluation
MOCK_LLM=true

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage paths
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIR=./data/chromadb
SOURCE_REGISTER_PATH=./data/source_register.csv
DOCUMENTS_DIR=./data/documents

# Optional Cloud LLM Fallback (must be disclosed in README per Section 5)
FALLBACK_CLOUD_LLM=false
FALLBACK_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
